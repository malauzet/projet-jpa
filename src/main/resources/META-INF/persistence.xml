<?xml version="1.0" encoding="UTF-8"?>
<persistence xmlns="https://jakarta.ee/xml/ns/persistence"
             xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
             xsi:schemaLocation="https://jakarta.ee/xml/ns/persistence https://jakarta.ee/xml/ns/persistence/persistence_3_0.xsd"
             version="3.0">
    <persistence-unit name="cinema" transaction-type="RESOURCE_LOCAL">
        <provider>org.hibernate.jpa.HibernatePersistenceProvider</provider>
        <class>fr.diginamic.cinema.entity.Pays</class>
        <class>fr.diginamic.cinema.entity.Langue</class>
        <class>fr.diginamic.cinema.entity.Genre</class>
        <class>fr.diginamic.cinema.entity.LieuNaissance</class>
        <class>fr.diginamic.cinema.entity.Personne</class>
        <class>fr.diginamic.cinema.entity.Role</class>
        <class>fr.diginamic.cinema.entity.Film</class>
        <properties>
            <property name="jakarta.persistence.jdbc.driver" value="org.mariadb.jdbc.Driver"/>
            <property name="jakarta.persistence.jdbc.url" value="jdbc:mariadb://localhost:3306/cinema?createDatabaseIfNotExist=true"/>

            <property name="hibernate.hbm2ddl.auto" value="validate"/>
            <property name="hibernate.dialect" value="org.hibernate.dialect.MariaDBDialect"/>
            <property name="hibernate.show_sql" value="false"/>
            <property name="hibernate.format_sql" value="false"/>
        </properties>
    </persistence-unit>
</persistence>